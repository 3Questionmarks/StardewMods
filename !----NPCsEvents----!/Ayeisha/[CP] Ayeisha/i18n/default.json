  "TwoPlayerPrairieKing.start": "I'm ready!",
  "TwoPlayerPrairieKing.mid": "I think we're half way there!",
  "TwoPlayerPrairieKing.end": "We beat the stage!",
  "TwoPlayerPrairieKing.die": "Sorry! I died!$s",

//* Generic Days *//

  "dialogue.Mon": "Hello @.",
  "dialogue.Tue": "Hey @.",
  "dialogue.Wed": "Hi @.",
  "dialogue.Thu": "Hello @.",
  "dialogue.Fri": "Hi @.",
  "dialogue.Sat": "Hey @.",
  "dialogue.Sun": "Hello @.",
  "dialogue.Mon2": "Hello @. Did you have a nice weekend?",
  "dialogue.Tue2": "Hello, I hope the crows aren't doing much damage.",
  "dialogue.Wed2": "Hi, how's %farm farm going?",
  "dialogue.Thu2": "Hey @. Have you been enjoying the weather?",
  "dialogue.Fri2": "How's your day going?",
  "dialogue.Sat2": "Hey @. Is it tiring to water your crops every day?",
  "dialogue.Sun2": "Hello @. Are you having a nice Sunday?",

  "dialogue.Mon4": "Do you ware out shoes quickly?#$b#All the walking I do and I get through a few pairs every year.",
  "dialogue.Tue4": "Do you ever get a chance to watch Livin' Off The Land?#$b#I try to watch it when I can. It's my favorite show.",
  "dialogue.Wed4": "Have you ever found anything buried on your farm?#$b#I've read that some farmers find old relics buried on their land.$h",

  "dialogue.summer_Wed4_1": "I think I'll watch a movie when I get home.",
  "dialogue.summer_Wed4_2": "What would you recommend?",
  "dialogue.summer_Wed4_3": "Larry Cobbler and the Labyrinth of Mystery",
  "dialogue.summer_Wed4_4": "Natural Wonders: The Deep Ocean World",
  "dialogue.summer_Wed4_5": "Farmer Nancy and her Huge Tracts of Land",
  "dialogue.summer_Wed4_6": "I don't know. Sorry.",
  "dialogue.summer_Wed4_7": "I think movies are really stupid.",
  "dialogue.filmquestion1": "Thanks, that's a good suggestion.$h",
  "dialogue.filmquestion2": "Good Idea! I love nature documentaries.$h",
  "dialogue.filmquestion3": "Err...$s",
  "dialogue.filmquestion4": "That's ok. I'll just browse the movie guide when I get home.",
  "dialogue.filmquestion5": "Oh... Um...$s",
  "dialogue.filmquestionfollowup01": "I enjoyed your suggestion last time.$h.",
  "dialogue.filmquestionfollowup02": "I think my cats would suggest 'A Ferngillian Tail'.",

  "dialogue.Thu4": "Hey, Have you ever been to Ridgeside?#$b#It has amazing views! However it's not part of my route so I rarely go.",
  "dialogue.Fri4": "Have you ever played the game 'Moondrop Hill?'#$b#It's this very cute farming game where you live in a small village.#$b#It reminds me of Pelican Town a lot.",
  "dialogue.Sat4": "Do you enjoy jigsaw puzzles?#$b#I do! They're fun to do on rainy evenings.$h",
  "dialogue.Sun4": "Hi, I guess you work Sundays too.#$e#Ferngill Post also delivers on Sundays.#$e#It's tiring, but I do get paid well.",
  "dialogue.Mon6": "$d cc#You did a great job at restoring Pelican Town's Community Center.$h#$b#I'm happy that it's back to its back former glory.$h|It's sad to see the Community Center in such a derelict state.$s#$b#I hope it gets restored one day.$s",
  "dialogue.Tue6": "My friend Rachael from ZuZu City baked me blackberry cobbler yesterday. It was delicious.$h",
  "dialogue.Wed6": "I found a pair of purple shorts by some bushes yesterday.$s#$b#It was disgusting. I hate people who leave their rubbish around.$s",
  "dialogue.Thu6": "I love trees. They're home to lots of wildlife.$h#$b#However they sometimes seem to spring up along parts of my route and it messes with my schedule.$s#$b#I sometimes feel like someone is doing it deliberately.$s",
  "dialogue.Fri6": "I find foraging really fun! Do you do it at all?$h#$e#I find lots of forage on my route and I use it for home cooking.#$b#You just have to be careful and do your research so that you don't pick anything that is poisonous.",

  "dialogue.winter_Fri6_1": "Hi @! I've been meaning to ask you something.",
  "dialogue.winter_Fri6_2": "How do you manage to hide all those crops and items on you?",
  "dialogue.winter_Fri6_3": "Sorry it's a trade secret.",
  "dialogue.winter_Fri6_4": "Probably the same way you manage to hide all those letters and packages.",
  "dialogue.winter_Fri6_5": "I'm not telling you.",
  "dialogue.itemscarryquestion1": "You farmers and your secrets.",
  "dialogue.itemscarryquestion2": "Oh?$u#$b#OOOOH! I see!$h",
  "dialogue.itemscarryquestion3": "Oh.$s",
  "dialogue.itemscarryfollowup01": "However I know you like your secrets.$h",
  "dialogue.itemscarryfollowup02": "However last time I asked, you were a bit blunt.$s",

//*NOTE TO ANY TRANSLATORS 'Indaway' might be difficult to translate. It's a joke as it sounds like 'In the way'.*//

  "dialogue.fall_Mon8_1": "I've got a new pet cat, I still need to name it.",
  "dialogue.fall_Mon8_2": "What do you think I should name my new cat?",
  "dialogue.fall_Mon8_3": "Oscar",
  "dialogue.fall_Mon8_4": "Tigger",
  "dialogue.fall_Mon8_5": "Indaway",
  "dialogue.fall_Mon8_6": "Sorry I'm not very good with names.",
  "dialogue.fall_Mon8_7": "Don't ask me. All my animals are named rude words.",
  "dialogue.fall_Mon8_8": "I'm not naming your silly pet for you.",
  "dialogue.catname0": "Oscar is a good idea. I'll think about it.",
  "dialogue.catname1": "Tigger is a good idea. I'll think about it.",
  "dialogue.catname2": "Inda...$s#$b#Oh very funny. No I'm not calling her that.$h",
  "dialogue.catname3": "That's ok. If you think of anything let me know.",
  "dialogue.catname4": "Oh... I definitely don't want her to be named a rude word.",
  "dialogue.catname5": "...$a",
  "dialogue.catnamefollowup01": "I love the suggestion you gave.$h",
  "dialogue.catnamefollowup02": "I don't think I will ask you for name suggestions again.$s",
  "dialogue.catnamefollowup03": "If you do think of a name then let me know.",

//*Dad Jokes That probably don't translate well at all.*//

  "dialogue.Tue8": "Oh hi! I forgot to tell you this story. I bumped into this old lady at the Zuzu City Bank last week.#$b#She was standing next to the cash machine and asked me to check her balance for her.#$b#So I pushed her over.$h",
  "dialogue.Mon10": "Did I tell you that I tried making a belt made of old watches?#$b#It was a waist of time.$h",
  "dialogue.Wed10": "Hey! Did I tell you I put my vacuum on JojaBay the other day?#$b#It was just gathering dust.$h",
  "dialogue.Sat10": "Hi! Do you know the best way to upgrade a pickaxe?#$b#With groundbreaking technology!$h",

//* Specific Days *//

  "dialogue.spring_1_2": "Happy New Year!",
  "dialogue.spring_2_1": "How was your first night on %farm?",
  "dialogue.spring_4_1": "I hope Jodi is ok. It's her husband's birthday today.$s",
  "dialogue.spring_14": "Hi @. Did you go to the egg festival yesterday?#$b#I hope I don't find any melted eggs in people's mailboxes again.$s",
  "dialogue.spring_24": "Hi @. Are you going to the Flower Dance? It's a nice day for it.",
  "dialogue.spring_25": "Did you go to the Flower Dance Yesterday?",

  "dialogue.summer_1_1": "I hope your first season's crops grew well.",
  "dialogue.summer_9": "It might be my birthday, however I enjoy my work.",
  "dialogue.summer_11": "Everyone should be going to the luau on the beach.",
  "dialogue.summer_28": "It's the Moonlight Jellies tonight. I should go one year. I've heard it's very beautiful.",

  "dialogue.fall_3": "I love the colour of the leaves at this time of year.",
  "dialogue.fall_27": "The town have done a great job at decorating the festival this year!$h#$b#It's very spooky!",
  "dialogue.fall_27_2": "They've done it again!$h#$b#The town always does a wonderful job at decorating their Spirit's Eve festival.$h",

  "dialogue.winter_1": "Do you know who Krowbis is? I have this strange letter.#$b#It's addressed to 'Misstar Krowbis - 1 Soo-ar'.#$b#It's very strange.$u",
  "dialogue.winter_7": "Are you going to the Festival of Ice tommorow?",
  "dialogue.winter_15": "Are you going to the Night Market?#$b#I go every year. I often find nice presents there for my friends and cats.",
  "dialogue.winter_15_2": "Are you going to this year's Night Market?#$b#There are usually new things to buy each year.",
  "dialogue.winter_17": "It's your last chance to go to the night market tonight.",
  "dialogue.winter_25": "Hey @. I arrived early today to give my presents.$h#$b#Oh and here is yours.[621]$h#$e#Pelican Town have done a great job decorating this year.$h#$e#It's a shame I can't stay, but I have plans with my family.",
  "dialogue.winter_25_2": "Hey @. I arrived early today to give my presents.$h#$b#Oh and here is yours.[645]$h#$e#Pelican Town have done another great job decorating.$h#$e#It's a shame I can't stay again, but I have plans with my family.",

}


