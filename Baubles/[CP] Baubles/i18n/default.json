//DESCRIPTIONS - MATERIALS

"appleseed.BCP.ateliertable.description": "A work station for sewing and assembling.",
"appleseed.BCP.dyeingbowl.description": "Used to naturally dye wool using flowers. Comes with its blueprints and a color guide.",
"appleseed.BCP.dyeingpot.description": "Used to dye cloth. Comes with its blueprints.",
