        "Entries": {
          "Custom_AdditionalFarmCave_1stArea": {
            "DisplayName": "{{i18n:DisplayName_AFC}}",
            "ExcludeFromNpcPathfinding": true,
            "CreateOnLoad": {
              "MapPath": "Maps\\Custom_AdditionalFarmCave_1stArea",
              "AlwaysActive": false
            },
            "FormerLocationNames": [ "Custom_AdditionalFarmCave" ]
          },
          "Custom_AdditionalFarmCave2": {
            "DisplayName": "{{i18n:DisplayName_AFC}}",
            "ExcludeFromNpcPathfinding": true,
            "CreateOnLoad": {
              "MapPath": "Maps\\Custom_AdditionalFarmCave2",
              "AlwaysActive": false
            }
          },
        }
      },

    //●日光の追加
      {
        "Priority": "Late",
        "Action": "EditMap",
        "Target": "Maps/{{DT_AddFarmCaveName}}",
        "FromFile": "assets/tmx/TsAFC_Sunlight.tmx",
        "ToArea": { "X": 6, "Y": 0, "Width": 13, "Height": 12 },
        "When": {
          "EnableThisMod": "true",
          "LocationName": "{{DT_AddFarmCaveName}}",
          "Time": "{{range:0600,1800}}",
          "Weather |contains=Rain,Storm,GreenRain": "false"
        },
        "Update": "OnLocationChange, OnTimeChange"
      },

    //●夜のジュニモ追加
      {
        "Action": "EditMap",
        "Priority": "Late",
        "Target": "Maps/{{DT_AddFarmCaveName}}",
        "FromFile": "assets/tmx/TsAFC_Nightjunimo.tmx",
        "ToArea": { "X": 4, "Y": 7, "Width": 3, "Height": 1 },
        "When": {
          "EnableThisMod": "true",
          "LocationName": "{{DT_AddFarmCaveName}}",
          "Time": "{{range:1800,2600}}"
        },
        "Update": "OnLocationChange, OnTimeChange"
      },

    //●メールデータ追加
      {
        "Action":"EditData",
        "Target":"Data/Mail",
        "Entries":{
          "{{ModId}}_CaveOpenMail": "{{i18n:Mail Text 01}}[#]{{i18n:Mail Title 01}}"
        },
        "When": {
          "EnableThisMod": "true"
        }
      },

    //●トリガーアクションデータ追加(洞窟開放メール用)
      {
        "Action": "EditData",
        "Target": "Data/TriggerActions",
        "Entries": {
          "{{ModId}}_CaveOpenMail_Trigger": {
            "Id": "{{ModId}}_CaveOpenMail_Trigger",
            "Trigger": "DayStarted",
            "Actions": [
              "AddMail All {{ModId}}_CaveOpenMail now"
            ],
            "Condition": "PLAYER_FRIENDSHIP_POINTS Current Robin 750,PLAYER_FRIENDSHIP_POINTS Current Demetrius 500,PLAYER_HAS_SEEN_EVENT Current 65"
          }
        },
        "When": {
          "EnableThisMod": "true"
        }
      },

    //●メッセージの追加
      {
        "Action":"EditData",
        "Target":"Strings/StringsFromMaps",
        "Entries":{
          "AdFCms01":"{{i18n:AdFCms01}}",
          "AdFCms02":"{{i18n:AdFCms02}}",
          "AdFCms03":"{{i18n:AdFCms03}}",
          "AdFCms04":"{{i18n:AdFCms04}}",
          "AdFCms05":"{{i18n:AdFCms05}}",
          "AdFCms06":"{{i18n:AdFCms06}}",
          "AdFCms07":"{{i18n:AdFCms07}}",
          "AdFCms08":"{{i18n:AdFCms08}}"
        },
        "When": {
          "EnableThisMod": "true"
        }
      },


  //★★★ バニラ環境時のエディットjson読み込み ★★★
      {
        "Action": "Include",
        "FromFile": "assets/json/Edit_Vanilla.json",
        "When": {
          "EnableThisMod": "true",
          "HasMod |contains=Hesper.HotSpringFarmcave,
                            acearohippo.PCFCVariety,
                            Aimon.MoreLivelyFarmCave,
                            neuralwiles.HiddenSpringFarmCave,
                            Wildflour.Hippo_Cliffside_FarmCave,
                            Kurimiu.PlantableFarmcave,
                            crystalinerose.FarmCaves,
                            Xiddav.FarmCave": "false"
        }
      },


  //★★★ 共通項目(奥のエリア)json読み込み ★★★
      {
        "Action": "Include",
        "FromFile": "assets/json/Edit_2ndArea.json",
        "When": {
          "EnableThisMod": "true"
        }
      },


  //★★★ 出入口変更の必要があるMODへの対応(それぞれのjsonへ飛ばす) ★★★

      {
        "Action": "Include",
        "FromFile": "assets/json/{{DT_ModJsonName}}.json",
        "When": {
          "HasValue:{{DT_ModJsonName}}": "true"
        }
      }


    ]//▼▼"Changes"の終了▼▼
