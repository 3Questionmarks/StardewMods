{
  "Format": "2.8.0",

  "ConfigSchema": {
//Setting to enable or disable the mod

		"RMP Enable (Earthy) Recolour":
		{
			"AllowValues": "ON, OFF",
			"Default": "ON",
			"Section": "RMP.ENABLE"
		}
	},

  "DynamicTokens": [
//SOURCE - Activates Vanilla style if Stardew Valley Expanded is NOT installed
		{
      "Name": "RMP.Source",
      "Value": "Vanilla",
      "When": { 
        "HasMod: |contains=FlashShifter.StardewValleyExpandedCP": false
       }
    },
		{
      "Name": "RMP.Source",
      "Value": "SVE",
      "When": { 
        "HasMod: |contains=FlashShifter.StardewValleyExpandedCP": true
      }
    },

//SEASONS - Default season to prevent main menu errors
	   {
      "Name": "RMP.Season",
      "Value": "spring"
    },
	  {
      "Name": "RMP.Season",
      "Value": "spring",
      "When": { 
        "Season": "spring"
      }
    },
		{
      "Name": "RMP.Season",
      "Value": "summer",
      "When": { 
        "Season": "summer"
      }
    },
		{
      "Name": "RMP.Season",
      "Value": "fall",
      "When": { 
        "Season": "fall"
      }
    },
		{
      "Name": "RMP.Season",
      "Value": "winter",
      "When": { 
        "Season": "winter"
      }
    },

//DEFENSE DIVISION - Identify the current property condition
	  {
      "Name": "RMP.DD.House",
      "Value": "Cx",
      "When": { 
			  "HasSeenEvent |contains=61743015": false,
			  "HasSeenEvent |contains=61743017": false,
			  "HasMod: |contains=DD.DefenseDivision": true
      }
    },
	  {
      "Name": "RMP.DD.House",
      "Value": "Loja.Comu.Cx",
      "When": {
			  "HasSeenEvent |contains=61743015": true,
			  "HasMod: |contains=DD.DefenseDivision": true
      }
    },
	  {
      "Name": "RMP.DD.House",
      "Value": "Loja.Joja.Cx",
      "When": { 
			  "HasSeenEvent |contains=61743017": true,
			  "HasMod: |contains=DD.DefenseDivision": true
      }
    },

//HALEY BAKERY - Identify the current property condition (old or new)
	  {
      "Name": "RMP.HaleyBakery.State",
      "Value": "Velho",
      "When": { 
			  "HasMod: |contains=kabulla.bakery": true
      }
    },
	  {
      "Name": "RMP.HaleyBakery.State",
      "Value": "Velho",
      "When": { 
			  "HasMod: |contains=kabulla.bakery": true,
        "HasSeenEvent: anyPlayer|contains=80801010": false
      }
    },
	  {
      "Name": "RMP.HaleyBakery.State",
      "Value": "Novo",
      "When": {
			  "HasMod: |contains=kabulla.bakery": true,
        "HasSeenEvent: anyPlayer|contains=80801010": true
      }
    },

//FIASA - Identify which type of relationship was chosen
	  {
      "Name": "RMP.FIASA.Bond",
      "Value": "Platonic",
      "When": { 
        "HasMod: |contains=CC.Koda.Platonic": true
      }
    },
	  {
      "Name": "RMP.FIASA.Bond",
      "Value": "Romance",
      "When": { 
        "HasMod: |contains=CC.Koda.Romance": true
      }
    }
  ],

