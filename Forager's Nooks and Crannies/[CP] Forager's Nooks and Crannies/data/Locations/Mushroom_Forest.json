{
		
"Changes": [

	{
		"LogName": "Load Mystical Forest Map",
		"Action": "Load",
		"Target": "Maps/{{ModId}}_MysticalForest",
		"FromFile": "assets/Maps/MysticalForest.tmx"
	},

	{
		"Action": "EditData",
		"Target": "Data/Locations",
		"Entries": {
		"{{ModId}}_MysticalForest": {
			"CreateOnLoad": {
				"MapPath": "Maps/{{ModId}}_MysticalForest",
				"AlwaysActive":true
			},
			"FormerLocationNames": [ "Custom_WF_MysticalForest"],
			"DisplayName": "{{i18n: MysticalForest}}",
			"CanPlantHere": false,
			"ExcludeFromNpcPathfinding": true,
            "DefaultArrivalTile": {
                "X": 14,
                "Y": 35
            },
			"Music": [],
            "MusicIgnoredInRain": false,
			"ArtifactSpots": [
			],
            "FishAreas": {},
            "Fish": [],
            "Forage": [
				{
                    "Id": "{{ModId}}_MushroomForest_Spring_Drops",
					"RandomItemId": [
						"(O)420",
						"(O)257"
              		],
					"Season":"spring",
                    "Chance": 1.0,
                },
				{
                    "Id": "{{ModId}}_MushroomForest_Summer_Drops",
					"RandomItemId": [
						"(O)422"
              		],
					"Season":"summer",
                    "Chance": 1.0
                },
				{
                    "Id": "{{ModId}}_MushroomForest_Fall_Drops",
					"RandomItemId": [
						"(O)281",
						"(O)Wildflour.NooksCrannies_Mush_Node"
              		],
					"Season":"fall",
                    "Chance": 1.0
                },
				{
                    "Id": "{{ModId}}_MushroomForest_Winter_Drops",
					"RandomItemId": [
						"(O)404",
						"(O)Wildflour.NooksCrannies_Mush_Node"
              		],
					"Season":"winter",
                    "Chance": 1.0
                },
				{
                    "Id": "{{ModId}}_WAG_MushroomForest_Spring_Drops",
					"ItemId": "(O)Wildflour.AtelierGoods_Honey_Fungus",
					"Season":"spring",
                    "Chance": 1.0,
                    "Condition":"{{HasMod |contains=Wildflour.AtelierGoods}}"
                },
				{
                    "Id": "{{ModId}}_WAG_MushroomForest_Summer_Drops",
					"ItemId": "(O)Wildflour.AtelierGoods_Wheatberry_Mushroom",
					"Season":"summer",
                    "Chance": 1.0,
                    "Condition":"{{HasMod |contains=Wildflour.AtelierGoods}}"
                },
				{
                    "Id": "{{ModId}}_WAG_MushroomForest_Fall_Drops",
					"ItemId": "(O)Wildflour.AtelierGoods_Milk_Mushroom",
					"Season":"fall",
                    "Chance": 1.0,
                    "Condition":"{{HasMod |contains=Wildflour.AtelierGoods}}"
                },
				{
                    "Id": "{{ModId}}_WAG_MushroomForest_Winter_Drops",
					"ItemId": "(O)Wildflour.AtelierGoods_Meringue_Mushroom",
					"Season":"winter",
                    "Chance": 1.0,
                    "Condition":"{{HasMod |contains=Wildflour.AtelierGoods}}"
                },
			],
			"MinDailyForageSpawn": 3,
			"MaxDailyForageSpawn": 8,
          	"MaxSpawnedForageAtOnce": 12,
          	"CustomFields": {
				"mistyspring.ItemExtensions/ClumpRemovalDays": 6,
				"mistyspring.ItemExtensions/NodeRemovalDays": 6,
			}
		}
	}
	},

//-----------------------------MAP PATCHES---------------------------//

{
	"LogName":"Map Patch Secret Woods for Mystical Forest",
	"Action": "EditMap",
	"Target": "Maps/Woods", 
	"FromFile": "assets/Maps/WoodsEdit.tmx",
	"ToArea": {
			"X": 4,
			"Y": 0,
			"Width": 7,
			"Height": 4
		},

	"When": {
		"MysticalForestToken": "1",
		"HasMod | contains=FlashShifter.StardewValleyExpandedCP": false
		}	
},

{
	"LogName":"Map Patch Secret Woods for Mystical Forest",
	"Action": "EditMap",
	"Target": "Maps/Woods", 
	"FromFile": "assets/Maps/WoodsEdit.tmx",
	"ToArea": {
			"X": 24,
			"Y": 0,
			"Width": 7,
			"Height": 4
		},

	"When": {
		"MysticalForestToken": "1",
		"HasMod | contains=FlashShifter.StardewValleyExpandedCP": true
		}
},

