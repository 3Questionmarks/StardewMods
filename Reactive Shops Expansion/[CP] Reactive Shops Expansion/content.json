			"AllowValues": "true, false",
			"Default": "false",
			"Section": "5. Misc.",
			"Description": "When true, limits all stock of items this mod adds to stores to be compatible with Realistic Seasonal Inventory - No More Unlimited Stock by boringvlln. Default false."
		}
		
