        "Tea Sapling Sell Price Nerf": {
			"AllowValues": "true, false",
			"Default": "true",
            "Section": "5. Misc.",
			"Description": "When true, lowers the Tea Sapling sell price so that crafting and selling the sapling is not profitable. This is recommended to keep enabled as I have added Tea Saplings to Pierre's stock, but I'm not your dad. Default true.",
        },
        "No Seeds For Coin Compatibility": {
			"AllowValues": "true, false",
			"Default": "false",
            "Section": "5. Misc.",
			"Description": "When true, removes this mod's additional seed entries from stores to be compatible with No Seeds For Coin - Seed Shortage by Pokkki. Default false."
        },
