{
    "Format": "2.0.3",
    
    "ConfigSchema": {
        "Mod Enabled": {
            "AllowValues": "true, false",
            "Default": "true"
        },
        "Bathhouse Layout": {
            "AllowValues": "Automatic, Vanilla, Less Ugly Town Interiors",
            "Default": "Automatic"
        },
        "Color Scheme": {
            "AllowValues": "Automatic, Vanilla, Vibrant Pastoral, Clean Bathhouse, Toned Down Match",
            "Default": "Automatic"
        }
    },
    
    "Changes": [
        {
            "LogName": "Load custom tiles",
            "Action": "Load",
            "Target": "Maps/mirror_tiles",
            "FromFile": "assets/mirror_tiles.png"
        },
        {
            "LogName": "Automatic recolor: VPR",
            "Action": "EditImage",
            "Target": "Maps/mirror_tiles",
            "FromFile": "assets/patches/tilesheets/Vibrant Pastoral.png",
            "When": {
                "HasMod": "grapeponta.VibrantPastoralRecolor",
                "Color Scheme": "Automatic"
            }
        },
        {
            "LogName": "Automatic recolor: clean bathhouse",
            "Action": "EditImage",
            "Target": "Maps/mirror_tiles",
            "FromFile": "assets/patches/tilesheets/Clean Bathhouse.png",
            "When": {
                "HasMod": "KaileyAllen.Cleanbathhouse",
                "Color Scheme": "Automatic"
            }
        },
        {
            "LogName": "Automatic recolor: toned down",
            "Action": "EditImage",
            "Target": "Maps/mirror_tiles",
            "FromFile": "assets/patches/tilesheets/Toned Down Match.png",
            "When": {
                "HasMod": "LaurellaBellaBean.CP.BathhouseRecolorTonedDown",
                "Color Scheme": "Automatic"
            }
        },
        {
            "LogName": "Manual recolor",
            "Action": "EditImage",
            "Target": "Maps/mirror_tiles",
            "FromFile": "assets/patches/tilesheets/{{Color Scheme}}.png",
            "When": { "HasFile:{{FromFile}}": true }
        },
        
        
