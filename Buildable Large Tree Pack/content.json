{
  "Format": "2.8.0",


    "ConfigSchema": {

      "EnableThisMod": {
        "AllowValues": "true, false",
        "Default": "true"
      },

      "RemoveBuildRestrictions": { //建設解放条件の削除
        "AllowValues": "true,false",
        "Default": "false"
      },
      "FreeToBuild": { //建設費がかからない
        "AllowValues": "true, false",
        "Default": "false"
      },
      "ImmediateBuildFinish": { //建設が一瞬で終わる
        "AllowValues": "true, false",
        "Default": "false"
      },
      "TransparentWhenGoBehind": { //背後に立った時に透過する
        "AllowValues": "true, false",
        "Default": "false"
      },
      "BuildOnTheFloor": { //装飾床の上に建設する
        "AllowValues": "true, false",
        "Default": "false"
      },
      "DisableAction": { //アクションを無効にする
        "AllowValues": "true, false",
        "Default": "false"
      },

      "Enable_Large": { //ラージ
        "AllowValues": "true, false",
        "Default": "true",
        "Section": "ConstructionMenu"
      },
      "Enable_Large_Replica": { //ラージ レプリカ
        "AllowValues": "true, false",
        "Default": "true",
        "Section": "ConstructionMenu"
      },
      "Enable_Town": { //タウン
        "AllowValues": "true, false",
        "Default": "true",
        "Section": "ConstructionMenu"
      },
      "Enable_Town_Replica": { //タウン レプリカ
        "AllowValues": "true, false",
        "Default": "true",
        "Section": "ConstructionMenu"
      },
      "Enable_Wild": { //ワイルド
        "AllowValues": "true, false",
        "Default": "true",
        "Section": "ConstructionMenu"
      },
      "Enable_Wild_Replica": { //ワイルド レプリカ
        "AllowValues": "true, false",
        "Default": "true",
        "Section": "ConstructionMenu"
      },
      "Enable_Very": { //ベリーラージ
        "AllowValues": "true, false",
        "Default": "true",
        "Section": "ConstructionMenu"
      },
      "Enable_Very_Replica": { //ベリーラージ レプリカ
        "AllowValues": "true, false",
        "Default": "true",
        "Section": "ConstructionMenu"
      }

    },//▼"ConfigSchema"の終了▼


    "DynamicTokens": [

