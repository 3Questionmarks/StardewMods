{
  "Format": "2.8.0",


    "ConfigSchema": {

      "EnableThisMod": { 
        "AllowValues": "true, false",
        "Default": "true" 
      },

      "OpenImmediately": { 
        "AllowValues": "true, false",
        "Default": "false",
        "Section": "S_1stArea"
      },
      "AvoidCertainBugs": { 
        "AllowValues": "true, false",
        "Default": "false",
        "Section": "S_1stArea"
      },

      "OpenImmediately_2nd": { 
        "AllowValues": "true, false",
        "Default": "false",
        "Section": "S_2ndArea"
      },
      "2ndArea_Minecart": { 
        "AllowValues": "true, false",
        "Default": "false",
        "Section": "S_2ndArea"
      },

      "KisaaFCP_CaveType": { //Kisaa's Farm Cave Packの設定
        "AllowValues": "Off, Green, Quarry, Springs, Cove, Fantasy",
        "Default": "Off",
        "Section": "S_KisaaFCP"
      },

      "XiddavFC_CaveType": { //Xiddav's Farm Caveの設定
        "AllowValues": "Default, Dark, Desert, Dino, Lava, Quarry, Dangerous, DarkDanger, DesertDanger, LavaDanger, LavaDark, LavaDarkDangerous",
        "Default": "Default",
        "Section": "S_XiddavFC"
      },

      "HFCV_CaveType": { //Hippo'sFarmCaveVarietyの設定
        "AllowValues": "farming, foraging, fishing, mining, combat, island, beach, hotspring",
        "AllowBlank": true,
        "Default": "farming",
        "Section": "S_HFCV"
      },
      "HFCV_MatchFarm": {
        "AllowValues": "true, false",
        "Default": "true",
        "Section": "S_HFCV"
      },
      "HFCV_AlternateCombat": {
        "AllowValues": "combat, hotspring",
        "Default": "combat",
        "Section": "S_HFCV"
      },
      "HFCV_AlternateIsland": {
        "AllowValues": "island, beach",
        "Default": "island",
        "Section": "S_HFCV"
      }

    },//▼"ConfigSchema"の終了▼


