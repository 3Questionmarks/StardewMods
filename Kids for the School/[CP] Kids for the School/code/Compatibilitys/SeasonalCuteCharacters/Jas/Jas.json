    },
    {
      "Action": "EditImage",
      "Target": "Characters/Jas_winter_indoor,",
      "FromFile": "code/Compatibilitys/SeasonalCuteCharacters/Jas/Jas_Winter_indoor.png",
      "Patchmode": "Overlay",
      "When": {
        "HasSeenEvent |contains=9695002": true,
        "HasMod |contains=Poltergeister.SeasonalCuteCharacters": true
      }
    }
  ]
}