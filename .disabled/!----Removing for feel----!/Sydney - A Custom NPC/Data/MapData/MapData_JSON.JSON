    		},
		{
      			"LogName": "Blank-load Spouse Room Map",
      			"Action": "Load",
      			"Priority": "Low", 
      			"Target": "Maps/Custom_sydLexSpouseRoom",
      			"FromFile": "data/MapData/Blank_SpouseRoom.json"
    		},
		{
			"LogName": "Create Sydney's Spouse Room",
      			"Action": "EditData",
      			"Target": "Data/Locations",
