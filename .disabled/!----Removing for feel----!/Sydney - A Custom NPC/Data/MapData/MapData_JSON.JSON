          			"DefaultArrivalTile": { "X": 5, "Y": 5 },
          			"CreateOnLoad": { "MapPath": "Maps/Custom_sydLexPatio" }
				},
			},
		},

		//Beach & Forest Clutter Removal 
		{
			"Action": "EditMap",
			"Target": "maps/Beach",
			"FromFile": "assets/maps/Custom_beachClutter.tmx",
			"FromArea": {
				"X": 0,
				"Y": 0,
				"Width": 12,
				"Height": 10
