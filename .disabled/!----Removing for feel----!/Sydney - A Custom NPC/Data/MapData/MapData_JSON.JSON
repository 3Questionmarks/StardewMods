				"HasMod |contains=DaisyNiko.EarthyRecolour": "false"
			}
		},
		{
			"Action": "EditImage",
			"Target": "maps/Z_Sydney_House",
			"FromFile": "assets/Tilesheets/Z_Sydney_House_winter.png",
