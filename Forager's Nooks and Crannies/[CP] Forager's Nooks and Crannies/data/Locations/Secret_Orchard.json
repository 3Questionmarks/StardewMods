//-----------------------------MAP PATCHES---------------------------//

{
	"LogName":"Map Patch Forest for Secret Orchard",
	"Action": "EditMap",
	"Target": "Maps/Forest", 
	"FromFile": "assets/Maps/ForestEdit.tmx",
	"ToArea": {
			"X": 97,
			"Y": 55,
			"Width": 2,
			"Height": 3
			},

	"When":{"SecretOrchardToken": "1"}
},

//-----------------------------WARPS---------------------------//

{
	"LogName":"Add Warp to Forest for Secret Orchard",
	"Action": "EditMap",
	"Target": "Maps/Forest",
	"AddWarps": ["98 57 {{ModId}}_SecretOrchard 31 13"],

	"When":{"SecretOrchardToken": "1"}		
},

{
	"LogName":"Add Warps to Secret Orchard",
