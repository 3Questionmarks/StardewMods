				"Custom_sydLexSpouseRoom": {
          			"DisplayName": "Sydney's Spouse Room",
          			"DefaultArrivalTile": { "X": 5, "Y": 5 },
          			"CreateOnLoad": { "MapPath": "Maps/Custom_sydLexSpouseRoom" }
				},
			},
		},
		//Spouse Patio Data
		{
      			"LogName": "Sydney Patio Map",
      			"Action": "Load",
      			"Priority": "High",
      			"Target": "Maps/Custom_sydLexPatio",
      			"FromFile": "assets/Maps/Custom_sydLexPatio.tmx"
