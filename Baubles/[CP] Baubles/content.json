{
  "Format": "2.9.0",
  "ConfigSchema":
    {
	"CurioUnlockMode":
	  {
	    "AllowValues": "MakeFriends, CompleteCC, Bookseller, Free",
	    "Default": "MakeFriends",
	    "Section": "Progression"
	  },
	"Quests":
	  {
	    "AllowValues": "On, Off",
	    "Default": "On",
	    "Section": "Progression"
	  },
	"SpecialOrders":
	  {
	    "AllowValues": "On, Off",
	    "Default": "On",
	    "Section": "Progression"
	  },
	"TinselShop":
	  {
	    "AllowValues": "True, False",
	    "Default": "True",
	    "Section": "Progression"
	  },
	"ShipItemsForPerfection":
	  {
	    "AllowValues": "On, Off",
	    "Default": "Off",
	    "Section": "Progression"
	  },
	"GiantCotton":
	  {
	    "AllowValues": "On, Off",
	    "Default": "On",
	    "Section": "ItemSpawning"
	  },
	 "CattailNodes":
	  {
	    "AllowValues": "On, Off",
	    "Default": "On",
	    "Section": "ItemSpawning"
	  },
	 "Animations":
	  {
	    "AllowValues": "On, Off",
	    "Default": "On",
	    "Section": "Sprites"
	  },
	"JellyStyle":
	  {
	    "AllowValues": "Default, Vanilla",
	    "Default": "Default",
	    "Section": "Sprites"
	  },
	"TinselPortrait":
	  {
	    "AllowValues": "Vanilla, Nyapu, None",
	    "Default": "None",
	    "Section": "Sprites"
	  }
    },
  "DynamicTokens":
    [
	{
	  "Name": "CollectionConfig",
	  "Value": "True",
	  "When": {"ShipItemsForPerfection": "Off"}
	},
	{
	  "Name": "CollectionConfig",
	  "Value": "False",
	  "When": {"ShipItemsForPerfection": "On"}
	},
	{
	  "Name": "JellyConfig",
	  "Value": 180,
	  "When": {"JellyStyle": "Vanilla"}
	},
	{
	  "Name": "JellyConfig",
	  "Value": 33,
	  "When": {"JellyStyle": "Default"}
	},
	{
	  "Name": "TinselStyle",
	  "Value": "",
	  "When": {"TinselPortrait": "None"}
	},
	{
	  "Name": "TinselStyle",
	  "Value": "Mods/appleseed.BCP/TinselPortrait",
	  "When": {"TinselPortrait": "Vanilla"}
	},
	{
	  "Name": "TinselStyle",
	  "Value": "Mods/appleseed.BCP/TinselPortraitN",
	  "When": {"TinselPortrait": "Nyapu"}
	},
	{
	  "Name": "TinselStyleW",
	  "Value": "",
	  "When": {"TinselPortrait": "None"}
	},
	{
	  "Name": "TinselStyleW",
	  "Value": "Mods/appleseed.BCP/TinselPortraitW",
	  "When": {"TinselPortrait": "Vanilla"}
	},
	{
	  "Name": "TinselStyleW",
	  "Value": "Mods/appleseed.BCP/TinselPortraitNW",
	  "When": {"TinselPortrait": "Nyapu"}
	}
    ],
  "Changes":
	[
	  {
	    "Action": "Include",
	    "FromFile": "Data/Objects.json, Data/BookTriggers.json, Data/CraftingData.json, Data/CraftingStation.json, Data/Crops.json, Data/GiftTastes.json, Data/GiftReactions.json, Data/Shops.json, Data/Letters.json, Data/Furniture.json, Data/Machines.json"
	  },
      	  {
	    "Action": "Load",
	    "Target": "Mods\\appleseed.BCP\\Nodes",
	    "FromFile": "Assets/Items/Nodes.png",
	    "When": 
	      {
		"HasMod |contains=mistyspring.ItemExtensions": true
	      }
          },
	  {
	    "Action": "Include",
	    "FromFile": "Data/NodesAndTreasure.json",
	    "When": 
	      {
		"HasMod |contains=mistyspring.ItemExtensions": true
	      }
	  },
	  {
	    "Action": "Include",
	    "FromFile": "Data/ShopTinsel.json",
	    "When":
		{
		  "TinselShop": "True"
		}
	  },
	  {
	    "Action": "Include",
	    "FromFile": "Data/Quests.json",
	    "When":
		{
		  "Quests": "On"
		}
	  },
	  {
	    "Action": "Include",
	    "FromFile": "Data/SpecialOrders.json, Data/SpecialOrderRewards.json",
	    "When":
		{
		  "SpecialOrders": "On"
		}
	  },
	  {
	    "Action": "Include",
	    "FromFile": "Data/Animations.json",
	    "When":
		{
		  "Animations": "On"
		}
	  },
	  {
	    "Action": "Include",
	    "FromFile": "Data/SCCategories.json, Data/Sounds.json, Data/SCItemProperties.json",
	    "When": 
	      {
		"HasMod |contains=spacechase0.SpaceCore": true
	      }
	  },
	  {
	    "Action": "Include",
	    "FromFile": "Data/Patches/SVBO.json",
	    "When": 
	      { 
		"HasMod|contains=Theoddon.BalanceOverhaul": true
	      }
	  },
	  {
	    "Action": "Include",
	    "FromFile": "Data/Patches/SVEGiftTastes.json",
	    "When": 
		{
		  "HasMod |contains=FlashShifter.StardewValleyExpandedCP": true
		}
	  },
	  {
	    "Action": "Include",
	    "FromFile": "Data/Patches/ESGiftTastes.json",
	    "When": 
		{
		  "HasMod |contains=Lemurkat.EastScarpNPCs": true
		}
	  }
	]
}