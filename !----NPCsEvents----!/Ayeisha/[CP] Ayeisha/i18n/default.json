//AYEISHA REPLACES MARNIE FOR PET ADOPTION

  "Pet.Adoption01": "Hi @!$h#$b#This cat...$s",
  "Pet.Adoption02": "I found it sitting on top of your mailbox this morning! I think it's a stray...$s",
  "Pet.Adoption03": "It seems to like this farm!#$b#I would look after it myself, but my other cat is unwell at the moment and needs my attention.$s#$b# I don't suppose this farm could use a cat?$h",
  "Pet.Adoption04": "I'll probably see you tomorrow morning %pet.$h",
  "Pet.Adoption05": "Hi @!$h#$b#This dog...$s",
  "Pet.Adoption06": "I found it laying by your mailbox this morning! I think it's a stray...$s",
  "Pet.Adoption07": "It seems to like this farm!#$b#I would look after it myself, but my cat would not be happy.$s#$b# I don't suppose this farm could use a dog?$h",
  "Pet.Adoption08": "No? Okay... I'll have to ask around to find a home for the poor thing.$s",
  "Pet.Adoption09": "No? Okay... I'll have to ask Jacob to see if he can help find a home for the poor thing.$s",

//Dialogue

  "dialogue.Introduction": "Hello, you must be the new farmer. I'm Ayeisha, I work for the Ferngill Postal Service. I normally get to your house by 5:30 in the morning.$h",
  "dialogue.BeachNightMarket": "Have you seen that mermaid show? It's here every year.$h",
  "dialogue.AyeishaVanRoad": "I wish I could park my van closer.",
  "dialogue.AyeishaWarpRoom": "HEY! You shouldn't be here! I could have been getting changed!$a#$b#Use warps more responsibly please!$a",
  "dialogue.Town_35_56": "HEY! How did you  get to this spot so quickly? Have you been using mods to cheat?!?!$u#$b#...or did my schedule break? Try sleeping 1 night to fix me or yell at TheLimeyDragon.",
  "dialogue.Saloon_15_20": "I finished early today so I am having a drink before I go home.#$b#Don't worry, it's not alchoholic.$h",
  "dialogue.StrayCatfe": "I had a very short shift today so I decided to have a drink at this café.$h",
  "dialogue.PetRejectionAyeisha": "Hello @. Don't worry about the the stray, a good home has been found!$h#$b#I was worried for a while.$s",
  "dialogue.ChickenAyeisha": "Hello @. Have you seen a strange gold coloured creature around? It stole my snack!$2",
  "dialogue.GreenRain": "It's a good thing I enjoy the rain, as this rain is very unusual.",
  "dialogue.GreenRainFinished": "Leah and I, seemed to be the only ones who weren't worried about that strange rain yesterday.$s",
  "dialogue.GreenRain_2": "This strange rain really makes the plants vibrant!$h",

//*Conversation Topics From Other Mods*//

  "dialogue.SterlingDrugs": "Sterling was getting very agitated at me today.$s#$b#He wanted to know why a package he ordered hadn't arrived.$s",
  "dialogue.SterlingRiver": "Sterling looks really happy lately!$h#$b#He apologised to me for being angry around me a while ago.",
  "dialogue.AfterProposal": "Yri told me that Charles proposed to her and she said yes! I'm so happy for them!$h",
  "dialogue.keahi_prank": "...$s#$b#Is it just me or is there an unpleasant smell around here?$s",
  "dialogue.JasperGone2": "Do you know where Jasper has gone?$s#$b#The Museum's mailbox is filling up with his mail.$s",

