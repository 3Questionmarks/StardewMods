//Little NPC's
    "AliasTokenNames": {
        "FirstbornName": "Candidus42.LittleNPCs/FirstLittleNPC:Name",
		"SecondbornName": "Candidus42.LittleNPCs/SecondLittleNPC:Name",
        "FirstLittleNPCDN": "Candidus42.LittleNPCs/FirstLittleNPC:DisplayName",
        "SecondLittleNPCDN": "Candidus42.LittleNPCs/SecondLittleNPC:DisplayName"
    },
    "DynamicTokens": [
//Little Red School House
        {"Name": "Fixed","Value":"false","When":{}},
        {"Name": "Fixed","Value":"true","When":{"HasSeenEvent": "9695002"}},
        {"Name": "IsOddYear","Value": "{{Query: {{Year}} % 2 = 1}}"},
        {"Name": "noschoolday","Value": "false","When":{}},
        {"Name": "noschoolday","Value": "true","When":{"day": "9, 23"}},
        {"Name": "Rundown","Value":"Rundown","When":{}},
        {"Name": "Rundown","Value":"","When":{"HasSeenEvent": "9695001"}},
        {"Name": "RSV","Value":""},
        {"Name": "RSV","Value":"RSV","When":{"HasMod|contains=Rafseazz.RSVCP": true}},	
//Growing Valley
        {"Name": "LRSH_NoSchoolDay","Value": false},
        {"Name": "LRSH_NoSchoolDay","Value": true,"When": {"day": "9, 23"}},
//Seasonal Improved Leo
        {
            "Name": "IndoorVariant", // Indoors
            "Value": "_Indoor",
            "When":
            {
                "IsOutdoors": "false"
            }
        },
        {
            "Name": "IndoorVariant", // Outdoors
            "Value": "_Outdoor",
            "When":
            {
                "IsOutdoors": "true"
            }
        },
//Firstborn Name Little NPC's
        {
            "Name": "FirstbornDisplayName",
            "Value": "{{siliconmodding.GVChildrenSMAPI/FirstbornNameErrorMessage}}",
            "When": {
            "HasValue: {{ChildGenders|valueAt=0}}": false,
            "HasMod |contains=siliconmodding.GVChildrenSMAPI": true,
            "HasMod |contains=Candidus42.LittleNPCs": true
            }
        },
        {
            "Name": "FirstbornDisplayName",
            "Value": "{{ChildNames|valueAt=0}}",
            "When": {
            "HasValue: {{ChildGenders|valueAt=0}}": true,
            "HasMod |contains=siliconmodding.GVChildrenSMAPI": true,
            "HasMod |contains=Candidus42.LittleNPCs": true
            }
        },
        {
            "Name": "FirstbornDisplayName",
            "Value": "{{Candidus42.LittleNPCs/FirstLittleNPC:DisplayName}}",
            "When": {
            "HasValue: {{Candidus42.LittleNPCs/FirstLittleNPC:DisplayName}}": true,
            "HasMod |contains=siliconmodding.GVChildrenSMAPI": true,
            "HasMod |contains=Candidus42.LittleNPCs": true
            }
        },
        {
			"Name": "FirstbornTokenPass",
			"Value": "|DisplayName={{FirstbornDisplayName}}"
		},
//Secondborn Name Little NPC's
        {
            "Name": "SecondbornDisplayName",
            "Value": "{{siliconmodding.GVChildrenSMAPI/SecondbornNameErrorMessage}}",
            "When": {
            "HasValue: {{ChildGenders|valueAt=1}}": false,
            "HasMod |contains=siliconmodding.GVChildrenSMAPI": true,
            "HasMod |contains=Candidus42.LittleNPCs": true
            }
        },
        {
            "Name": "SecondbornDisplayName",
            "Value": "{{ChildNames|valueAt=1}}",
            "When": {
            "HasValue: {{ChildGenders|valueAt=1}}": true,
            "HasMod |contains=siliconmodding.GVChildrenSMAPI": true,
            "HasMod |contains=Candidus42.LittleNPCs": true
            }
        },
        {
            "Name": "SecondbornDisplayName",
            "Value": "{{Candidus42.LittleNPCs/SecondLittleNPC:DisplayName}}",
            "When": {
            "HasValue: {{Candidus42.LittleNPCs/SecondLittleNPC:DisplayName}}": true,
            "HasMod |contains=siliconmodding.GVChildrenSMAPI": true,
            "HasMod |contains=Candidus42.LittleNPCs": true
            }
        },
        {
			"Name": "SecondbornTokenPass",
			"Value": "|DisplayName={{SecondbornDisplayName}}"
		}
