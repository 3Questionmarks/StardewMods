{
  "Format": "2.8.0",
  "ConfigSchema": {


"NpcWarpTownBusStopRoute": {
 	"AllowValues": "True, False,",
	"Default": "True",
	"Description": "Adds an NpcWarp at the main stardew valley town bus stop for NPCS. Disable if it causes issues.",
},


"AmbientLightPatches": {
      "AllowValues": "Dim, Dark, Vanilla",
      "Default": "Vanilla",
      "Description": "Disables the dark ambient lighting in the cape stardew cavern. Requires a restart."
    },

"SmallDockAtCape": {
"AllowValues": "On, Off",
      "Default": "On",
      "Description": "Adds a small dock on the cape."
},

"TimeBasedMapPatches": {
      "AllowValues": "On, Off",
      "Default": "Off",
      "Description": "Patches the map at certain times usually to change the setting. Can cause slowdown."
    },

"RingsBalance": {
"AllowValues": "Vanilla, Stronger",
      "Default": "Vanilla",
"Description": "Sets the effects of the rings found."
},
"WeaponsBalance": {
      "AllowValues": "Vanilla, Balanced, Stronger",
      "Default": "Vanilla",
      "Description": "Sets the strength of the weapons found."
    },

"MuseumCompatConfig": {
	"AllowValues": "ExtraMuseumRoomVer2, VMVMuseumPatch, JasperNPCMuseumPatch, ExtraMuseumRoomGlassVer2, VMVMuseumPatchGlass, JasperNPCMuseumPatchGlass, None",
	"Default": "JasperNPCMuseumPatch",
	"Description": "Toggle the Compat patch for MGR + Geology Mod",
},

"ExtraMuseumRoom": {
      "AllowValues": "ExtraMuseumRoom, ExtraMuseumRoomGlass, None",
      "Default": "ExtraMuseumRoom",
      "Description": "additional Museum Room added below the library section."
    },


    "BusStopBuildings": {
      "AllowValues": "true, false",
      "Default": "true",
      "Description": "unlock cape BusStop as builable area"
    },

"RingBuffsGlow": {
"AllowValues": "true, false",
"Default": "true",
"Description": "Custom rings glow"
},



    "Custom_Ores": {
      "AllowValues": "true, false",
      "Default": "true",
      "Description": "A new custom ore which contains the diamonds from CapeStardew"
    },
    "Enable_Cape_Minecart": {
      "AllowValues": "true, false",
      "Default": "true",
      "Description": "A minecart will appear in the Sea Cave after exploring it."
    },
    "ReimaginedForestPatch": {
      "AllowValues": "on, off",
      "Default": "on"
    },
    "VanillaForestPatch": {
      "AllowValues": "on, off",
      "Default": "on"
    },
    "ExpandedForestPatch": {
      "AllowValues": "on, off",
      "Default": "on"
    },
    "Green Fall": {
      "AllowValues": "true, false",
      "Default": "true"
    },
    "BoatDockedAtBeach": {
      "AllowValues": "true, false",
      "Default": "true",
      "Description": "disables the boat at the beach once Unlocked."
    },
    "RepeatFallingCutscene": {
      "AllowValues": "true, false",
      "Default": "true",
"Description": "Repeats the falling cutscenes inside of the caverns."
    },
    "BusAtCape": {
      "AllowValues": "on, off",
      "Default": "off",
      "Description": "Disables the bus visual at the cape."
    },
    "AllowWildAnimals": {
      "AllowValues": "on, off",
      "Default": "off",
      "Description": "Allows wild animals to appear on the Cape with Wild Animals mod."
    },
    "Enable Legendary Fish Cape": {
      "AllowValues": "true, false",
      "Default": "false",
      "Description": "Legendary fish will appear outside."
    },
    "Enable Legendary Fish SeaCave": {
      "AllowValues": "true, false",
      "Default": "false",
      "Description": "Legendary fish will appear inside."
    },
    "ShadowStrikeProjectile": {
      "AllowValues": "on, off",
      "Default": "on"
    },
"MossyDewProjectile": {
      "AllowValues": "on, off",
      "Default": "on"
    },
"WitherHollowProjectile": {
      "AllowValues": "on, off",
      "Default": "on"
    },
"GlacialWindProjectile": {
      "AllowValues": "on, off",
      "Default": "on"
    }

  },
  "DynamicTokens": [
{
