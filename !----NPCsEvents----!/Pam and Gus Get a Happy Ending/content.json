//EVENTS, DIALOGUE, SCHEDULES

	//1. ALWAYS LOAD: Universal events unaffected by Gus's variant
	{
	"LogName": "Events, Dialogue & Schedules",
		"Action": "Include",
		"When": {
			"PamGusHappyEndingActive": "true"
			},
		"FromFile": "assets/Events/events.json, assets/Events/triggeractions.json, assets/Dialogue/dialogue.json, assets/Schedules/schedules.json"
		},
	//2. DSV TURKISH GUS: Player has DSV AND the Turkish variant is active
	{
	"LogName": "Events: Load DSV-specific events for Turkish Gus",
		"Action": "Include",
		"When": {
			"PamGusHappyEndingActive": "true",
			"HasMod |contains=DSV.Core": "true",
			"DSV.Core/ConfigValue:GusVariant |contains= Modded": true
			},
		"FromFile": "assets/Events/events-dsv.json"
		},
	//3. VANILLA GUS (SCENARIO A): Player does NOT have DSV installed
	{
	"LogName": "Events: Load Vanilla events for DSV not installed",
		"Action": "Include",
		"When": {
			"PamGusHappyEndingActive": "true",
			"HasMod |contains=DSV.Core": "false"
			},
		"FromFile": "assets/Events/events-vanilla.json"
		},
	//4. VANILLA GUS (SCENARIO B): Player HAS DSV installed, but Gus is Vanilla
	{
	"LogName": "Events: Load Vanilla events for DSV without Turkish Gus",
		"Action": "Include",
		"When": {
			"PamGusHappyEndingActive": "true",
			"HasMod |contains=DSV.Core": "true",
			"DSV.Core/ConfigValue:GusVariant |contains= Modded": false
			},
		"FromFile": "assets/Events/events-vanilla.json"
		},
