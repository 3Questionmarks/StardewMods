{
  "$schema": "https://smapi.io/schemas/content-patcher.json",
  "Format": "2.9.0",
  "Changes": [
    {
      "LogName": "Load tmx into Maps",
      "Action": "Load",
      "Target": "Maps/{{ModId}}_SeaCave",
      "FromFile": "assets/Maps/dedpeechSeaCave.tmx"
    },
    {
      "LogName": "Add custom location to Locations",
      "Action": "EditData",
      "Target": "Data/Locations",
      "Entries": {
        "{{ModId}}_SeaCave": {
          "DisplayName": "Sea Cave",
          "CreateOnLoad": {
            "MapPath": "Maps/{{ModId}}_SeaCave"
          }
        }
      }
    },
    {
      "LogName": "Add Large Rock to East Pier",
      "Action": "EditMap",
      "Target": "Maps/Beach",
      "PatchMode": "Replace",
      "FromFile": "Assets/Maps/BeachPatch.tmx",
      "FromArea": {
        "X": 0,
        "Y": 0,
        "Width": 6,
        "Height": 4
      },
      "ToArea": {
        "X": 90,
        "Y": 37,
        "Width": 6,
        "Height": 4
      }
    },
    {
