                "HasMod |contains=Zilch.SeasonalImprovedLeo": true,
            },
        },
//Portrait Loads when use Seasonal Improved Leo New Portrait
        {
            "Action": "EditImage",
            "Target": "Portraits/ParrotBoy",
            "FromFile": "code/Compatibilitys/SeasonalImprovedLeo/Portraits/portrait_NewLeo.png",
            "When": {
                "HasSeenEvent |contains=9695002": true,
                "HasSeenEvent |contains=6497428": true,
