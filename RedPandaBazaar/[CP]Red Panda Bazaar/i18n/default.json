    /*** spring8 1 Year***/
    "Marlon.SpringFair.festivals": "Oh, hello there. #$b#I might have some items you'd find useful.",
    "Pierre.SpringFair.festivals": "@!$4#$b#Come take a look at the new scarecrow I made! $1",
    "Alex.SpringFair.festivals": "Good thing I brought my gridball. $3#$e#So, are you planning to buy anything, @?",
    "Elliott.SpringFair.festivals": "I thought Lewis would come up with something weird again. $1#$e#Have you checked out the café run by that pink-haired woman?",
    "Harvey.SpringFair.festivals": "This place isn't too far from Pelican Town. #$e#But where did Evelyn get all those pots? $2",
    "Sam.SpringFair.festivals": "The other day, I asked Sebastian what he planned to sell today. Want to guess his answer? #$e#He said he'd rather hang out with the frogs. $1",
    "Sebastian.SpringFair.festivals": "Me? I don't take buses. #$b#Riding a motorcycle is way cooler than sitting on a bus. $7",
